DATABASE_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase project (server-side only — never expose SUPABASE_ACCESS_TOKEN to a client/browser)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_ACCESS_TOKEN="sbp_..."

SESSION_COOKIE_NAME="predictsim_sid"
PORT=3000

# Only consulted when NODE_ENV=production. In development any localhost port
# is allowed automatically. Comma-separated, exact origins (scheme+host+port).
CORS_ALLOWED_ORIGINS=""

BOOTSTRAP_ADMIN_EMAIL="platform-admin@predictsim.local"
BOOTSTRAP_ADMIN_PASSWORD="change-this-immediately-123"
